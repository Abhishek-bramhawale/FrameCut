# Render backend (required for processing)
# CLOUDINARY_* optional — when set, uploads go to Cloudinary and outputs are published there.

# Memory limits on small hosts (Render free tier defaults in Dockerfile):
# FRAMCUT_LOW_MEMORY=1
# FRAMCUT_SCENE_METHOD=ffmpeg
# FRAMCUT_MAX_CONCURRENT_JOBS=1
# FRAMCUT_MAX_EXPORT_WORKERS=1

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned upload preset (Settings → Upload → Upload presets)
CLOUDINARY_UPLOAD_PRESET=
