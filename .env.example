# Render backend (required for processing)
# CLOUDINARY_* optional — when set, uploads go to Cloudinary and outputs are published there.

# Memory limits on small hosts (Render free tier; also auto-enabled when RENDER is set):
# FRAMECUT_LOW_MEMORY=1
# FRAMECUT_SCENE_METHOD=ffmpeg
# FRAMECUT_MAX_CONCURRENT_JOBS=1
# FRAMECUT_MAX_EXPORT_WORKERS=1
# FRAMECUT_MAX_SCENES=100

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned upload preset (Settings → Upload → Upload presets)
CLOUDINARY_UPLOAD_PRESET=
